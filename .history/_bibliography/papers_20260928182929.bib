@phdthesis{balleroyUsingNaturalisticSpeech2023,
  type = {Unpublished {{Master}}'s Thesis},
  title = {Using Naturalistic Speech {{EEG}} Recordings to Test the Cognitive Reality of Representations Suggested by a Computational Model of Early Phonetic Learning},
  author = {Balleroy, Ambre},
  year = 2023,
  abstract = {Un r\'ecent mod\`ele computationel de l'apprentissage phon\'etique pr\'ecoce pr\'edit que les enfants n'apprennent peut-\^etre pas des cat\'egories phon\'etiques mais des unit\'es \`a la granularit\'e plus fine. Bien que ce mod\`ele pr\'edise avec succ\`es certains effets comportementaux, cela ne garantit pas que les repr\'esentations internes du mod\`ele fournissent un \'equivalent fid\`ele des repr\'esentations cognitives humaines. Nous testons la r\'ealit\'e cognitive des unit\'es apprises par le mod\`ele en utilisant une approche d'encodage de la parole continue (la multivariate Temporal Response Function) sur un jeu de donn\'ees d'\'electroenc\'ephalogrammes librement disponible. L'activit\'e c\'er\'ebrale enregistr\'ee pendant que les participants \'ecoutaient un livre audio a \'et\'e pr\'edite de mani\`ere significativement sup\'erieure au niveau de chance en utilisant des caract\'eristiques repr\'esentant les onsets des unit\'es, mais pas leur entropie. Cependant, les onsets n'avaient pas de valeur ajout\'ee lorsqu'ils \'etaient combin\'es \`a des lignes de base acoustiques \'etablies (une combinaison d'un spectrogramme et d'onsets acoustiques). Comme les informations contenues dans les unit\'es apprises par le mod\`ele test\'e ne sont pas significativement pr\'esentes dans l'activit\'e c\'er\'ebrale ou sont redondantes avec des informations acoustiques de bas niveau, cela ne plaide pas en faveur de leur r\'ealit\'e cognitive. D'autres travaux sont toutefois n\'ecessaires avant de pouvoir tirer une conclusion d\'efinitive et nous discutons de prochaines \'etapes, par exemple de nouvelles mani\`eres de r\'esumer les unit\'es qui pr\'eserveraient leurs caract\'eristiques d\'ependantes de la langue, et la r\'eplication de la pr\'esente analyse \`a l'aide de donn\'ees issues de nourrissons, afin de v\'erifier si les unit\'es sont transitoires au cours du d\'eveloppement.},
  langid = {english},
  school = {Aix-Marseille Universit\'e},
}

